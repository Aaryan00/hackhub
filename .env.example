# ---------------------------------------------------------------------------
# HackHub environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# NEVER commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Settings → API → Project API keys → anon public)
# Safe to expose to the browser; RLS policies enforce access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Settings → API → Project API keys → service_role)
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for admin/seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app (used for OAuth redirect callbacks).
# Local: http://localhost:3000  |  Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
